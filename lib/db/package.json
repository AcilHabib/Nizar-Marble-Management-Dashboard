{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate --schema ./prisma/schema.prisma",
    "push": "dotenv -e ../../.env -- prisma db push --schema ./prisma/schema.prisma --skip-generate",
    "seed": "tsx ./prisma/seed.ts",
    "migrate-slices": "tsx ./prisma/migrate-slices-to-meters.ts",
    "postinstall": "dotenv -e ../../.env -- prisma generate --schema ./prisma/schema.prisma || prisma generate --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5"
  }
}
